generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Property {
  id            Int      @id @default(autoincrement())
  name          String
  address       String   @default("")
  propertyType  String   @default("")
  manager       String   @default("")
  owner         String   @default("")
  notes         String   @default("")
  units         Unit[]
  tenants       Tenant[]
  rentRolls     RentRoll[]
  expenses      Expense[]
  deposits      Deposit[]
  maintenance   MaintenanceLog[]
}

model Unit {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  unitName    String
  useType     String   @default("")
  status      String   @default("Vacant")
  monthlyRent Float    @default(0)
  monthlyLevy Float    @default(0)
  notes       String   @default("")
  property    Property @relation(fields: [propertyId], references: [id])
  tenants     Tenant[]
  rentRolls   RentRoll[]
  maintenance MaintenanceLog[]
}

model Tenant {
  id                   Int      @id @default(autoincrement())
  propertyId           Int
  unitId               Int
  tenantName           String
  tradingName          String   @default("")
  businessType         String   @default("")
  phone                String   @default("")
  email                String   @default("")
  commissionApplicable Boolean  @default(true)
  commissionRate       Float    @default(0.10)
  notes                String   @default("")
  property             Property @relation(fields: [propertyId], references: [id])
  unit                 Unit     @relation(fields: [unitId], references: [id])
  rentRolls            RentRoll[]
  deposits             Deposit[]
}

model RentRoll {
  id               Int      @id @default(autoincrement())
  propertyId       Int
  unitId           Int
  tenantId         Int
  month            String
  rentDue          Float    @default(0)
  rentPaid         Float    @default(0)
  levyDue          Float    @default(0)
  levyPaid         Float    @default(0)
  receiptNumber    String   @default("")
  commissionRate   Float    @default(0.10)
  commissionAmount Float    @default(0)
  notes            String   @default("")
  property         Property @relation(fields: [propertyId], references: [id])
  unit             Unit     @relation(fields: [unitId], references: [id])
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
}

model Expense {
  id          Int      @id @default(autoincrement())
  propertyId  Int
  month       String
  expenseType String
  supplier    String   @default("")
  currency    String   @default("USD")
  amount      Float    @default(0)
  status      String   @default("Due")
  notes       String   @default("")
  property    Property @relation(fields: [propertyId], references: [id])
}

model Deposit {
  id         Int      @id @default(autoincrement())
  propertyId Int
  tenantId   Int
  amount     Float
  currency   String   @default("USD")
  heldBy     String   @default("")
  notes      String   @default("")
  property   Property @relation(fields: [propertyId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model MaintenanceLog {
  id            Int       @id @default(autoincrement())
  propertyId    Int
  unitId        Int?
  issue         String
  priority      String    @default("Medium")
  status        String    @default("Open")
  estimatedCost Float     @default(0)
  notes         String    @default("")
  property      Property  @relation(fields: [propertyId], references: [id])
  unit          Unit?     @relation(fields: [unitId], references: [id])
}
